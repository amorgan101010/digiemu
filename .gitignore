# Elektron firmware and anything derived from it is copyright Elektron.
# Never commit it. Users supply their own lawfully-obtained copy.
*.syx
*.zip
*_readme.html
sections/
out/
venv/
__pycache__/
*.pyc
vendor/
snapshots/
*.snap

# +Drive card images hold the user's projects and samples (often third-party
# sample packs), and recordings are the firmware's output: never commit either.
*.img
*.img.*
*.wav
*.log
.DS_Store

# uv
.venv/

# CI's cached patched Unicorn (.github/workflows/ci.yml)
.ci-cache/

# The portable app. portable/ is its dev data root, and firmware/ is the same
# data if DIGIKIT_HOME points at the repo. Each firmware's folder holds the
# user's .syx copy, sections, snapshots, the +Drive card and state
# (firmware.json, .lock, a devices/ overlay). The rest is PyInstaller output.
# tools/build-windows.ps1 builds outside the tree; these catch a run by hand.
# packaging/digikit.spec is tracked; /*.spec is a spec PyInstaller generates.
/portable/
/firmware/
/build/
/dist/
/build-out/
/*.spec

# NXP reference manuals: ~11 MB of vendor PDF, plus the text dump generated
# from one of them. Fetch your own copies; the notes extracted from them
# (docs/refs/*.md) are committed and cite chapter and table numbers.
docs/refs/*.pdf
docs/refs/rm.txt
# Elektron's user manuals, kept at the top level for reference: their copyright.
/*User*Manual*.pdf
.coldtrace/
tools/ghidra/SHARC/data/languages/*.sla
tools/ghidra/ColdfireEMAC/data/languages/*.sla
tools/ghidra/ColdfireEMAC/extension.properties
tools/nbdocs-scrape.py

# tools/sharcspec: text extracts of the ADI manuals and generated renders and
# Ghidra language files. The PDFs themselves are covered by docs/refs/*.pdf.
docs/refs/pgr.txt
docs/refs/prm.txt
tools/sharcspec/renders/
tools/sharcspec/ghidra/SHARC_VISA/
